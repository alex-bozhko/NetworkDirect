<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!-- Disable Spectre-mitigated library requirement; avoids MSB8040 when
         Spectre libs are not installed via the VS installer. -->
    <SpectreMitigation>false</SpectreMitigation>
  </PropertyGroup>
</Project>
